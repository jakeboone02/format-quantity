{
  "version": "3.1.0",
  "name": "format-quantity",
  "author": "Jake Boone <jakeboone02@gmail.com>",
  "description": "Number formatter for imperial measurements with support for vulgar fractions",
  "files": [
    "dist"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/format-quantity.legacy-esm.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/format-quantity.d.mts",
        "default": "./dist/format-quantity.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "types": "./dist/format-quantity.legacy-esm.d.ts",
  "sideEffects": false,
  "unpkg": "./dist/format-quantity.iife.umd.min.js",
  "license": "MIT",
  "keywords": [
    "recipe",
    "ingredient",
    "quantity",
    "number",
    "format",
    "string",
    "fractions",
    "imperial",
    "roman",
    "numerals"
  ],
  "bugs": {
    "url": "https://github.com/jakeboone02/format-quantity/issues"
  },
  "homepage": "https://github.com/jakeboone02/format-quantity",
  "repository": {
    "type": "git",
    "url": "https://github.com/jakeboone02/format-quantity"
  },
  "scripts": {
    "start": "bun --hot main.html",
    "build": "bun --bun x tsdown",
    "docs:plugins": "bun build ./node_modules/typedoc-plugin-katex/src/index.tsx --outdir=. --target=node --external=typedoc --entry-naming=typedoc-plugin-katex.mjs",
    "docs": "typedoc",
    "test": "bun test",
    "watch": "bun test --watch",
    "lint": "bunx oxlint",
    "publish:npm": "np",
    "fmt": "oxfmt"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.3.0",
    "@types/web": "^0.0.354",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "np": "^12.0.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "typedoc": "^0.28.20",
    "typedoc-plugin-katex": "^0.1.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "numeric-quantity": "^3.3.0"
  }
}
